# Contact Form Production Configuration
# Copy this file to .env and set your credentials. Never commit your actual .env file!

# Form Endpoint (Supported: Web3Forms, Formspree, or custom serverless endpoint)
VITE_CONTACT_API_URL=https://api.web3forms.com/submit

# Access Key for Web3Forms or Formspree form ID
VITE_CONTACT_ACCESS_KEY=your_access_key_here

# Destination Email
VITE_CONTACT_TO_EMAIL=inbox.DivyanshGupta1@protonmail.com

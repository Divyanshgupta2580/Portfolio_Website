# ===================================================================
# Divyansh Gupta Portfolio — Environment Configuration
# ===================================================================
# Copy this file to .env for local testing or set these variables in Vercel Settings.
# NOTE: Never commit your actual .env file or credentials to Git!

# OPTION 1: Vercel Serverless Function with Resend (Recommended for Vercel)
# Obtain your API key from: https://resend.com
RESEND_API_KEY=re_your_api_key_here
CONTACT_TO_EMAIL=inbox.DivyanshGupta1@protonmail.com
CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

# OPTION 2: Client-side Formspree Integration (Optional Alternative)
# If using Formspree (https://formspree.io), set your form endpoint:
# VITE_CONTACT_API_URL=https://formspree.io/f/your_form_id

# OPTION 3: Client-side Web3Forms Integration (Optional Alternative)
# If using Web3Forms (https://web3forms.com), set your access key:
# VITE_CONTACT_API_URL=https://api.web3forms.com/submit
# VITE_CONTACT_ACCESS_KEY=your_web3forms_access_key_here
